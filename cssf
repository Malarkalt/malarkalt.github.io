:root {
  --bg: #faf7f2;
  --card: #ffffff;
  --ink: #1d2433;
  --muted: #687082;
  --line: #e7e1d7;
  --accent: #0f766e;
  --accent-ink: #ffffff;
  --accent-soft: #e3f3f1;
  --warn: #b45309;
  --warn-soft: #fdf1e1;
  --danger: #b42318;
  --danger-soft: #fdeceb;
  --ok: #15803d;
  --ok-soft: #e6f6ea;
  --radius: 14px;
  --shadow: 0 1px 2px rgba(29, 36, 51, .05), 0 6px 20px rgba(29, 36, 51, .05);
}
* { box-sizing: border-box; }
html, body { margin: 0; }
body {
  font: 16px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--bg); color: var(--ink);
}
a { color: var(--accent); }
h1, h2, h3 { line-height: 1.2; margin: 0 0 .5rem; }
h1 { font-size: 1.8rem; letter-spacing: -.02em; }
h2 { font-size: 1.15rem; }
p { margin: 0 0 .75rem; }
.hidden { display: none !important; }
.muted { color: var(--muted); }
.hint { color: var(--muted); font-size: .88rem; margin-top: .5rem; }
.pre { white-space: pre-wrap; word-break: break-word; }

/* Layout */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: .9rem 1.25rem; border-bottom: 1px solid var(--line); background: var(--card);
}
.brand { font-weight: 800; font-size: 1.2rem; color: var(--ink); text-decoration: none; letter-spacing: -.02em; }
.brand span { color: var(--accent); }
.topbar-right { display: flex; gap: .75rem; align-items: center; font-size: .9rem; color: var(--muted); }
.wrap { max-width: 860px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
.narrow { max-width: 640px; }
.row { display: flex; gap: .75rem; align-items: center; }
.between { justify-content: space-between; }
.wrapflex { flex-wrap: wrap; }
.stack > * + * { margin-top: 1rem; }

/* Cards */
.card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; box-shadow: var(--shadow); }
.card + .card { margin-top: 1rem; }
.cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin-top: 1rem; }
.event-card { cursor: pointer; transition: transform .12s, border-color .12s; text-align: left; font: inherit; color: inherit; width: 100%; }
.event-card:hover { transform: translateY(-2px); border-color: var(--accent); }
.event-card h3 { font-size: 1.05rem; }
.empty { text-align: center; padding: 2.5rem 1rem; color: var(--muted); border: 2px dashed var(--line); border-radius: var(--radius); margin-top: 1rem; }

/* Buttons */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: .4rem;
  background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent);
  padding: .6rem 1rem; border-radius: 10px; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none;
}
.btn:hover { filter: brightness(1.08); }
.btn:disabled { opacity: .55; cursor: not-allowed; }
.btn.ghost { background: transparent; color: var(--ink); border-color: var(--line); }
.btn.ghost:hover { border-color: var(--ink); filter: none; }
.btn.danger { background: var(--danger); border-color: var(--danger); }
.btn.danger.ghost { background: transparent; color: var(--danger); border-color: #f1c6c2; }
.btn.sm { padding: .35rem .7rem; font-size: .88rem; }
.btn.big { padding: .9rem 1.5rem; font-size: 1.1rem; width: 100%; }
.linkbtn { background: none; border: 0; color: var(--accent); font: inherit; cursor: pointer; padding: 0; }
.back { margin-bottom: 1rem; }

/* Forms */
.form label { display: block; font-weight: 600; font-size: .92rem; margin-bottom: .3rem; }
.field { margin-bottom: 1rem; }
.input, .form input, .form textarea, .form select {
  width: 100%; padding: .65rem .8rem; border: 1px solid var(--line); border-radius: 10px;
  font: inherit; background: #fff; color: var(--ink);
}
.input:focus, .form input:focus, .form textarea:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }
.form textarea { min-height: 110px; resize: vertical; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
.grid-cost { display: grid; grid-template-columns: 90px 1fr; gap: 0 1rem; }
@media (max-width: 560px) { .grid2 { grid-template-columns: 1fr; } }
.checklist { list-style: none; padding: 0; margin: .4rem 0 0; font-size: .85rem; color: var(--muted); }
.checklist li::before { content: "○ "; }
.checklist li.ok { color: var(--ok); }
.checklist li.ok::before { content: "● "; }
.form-error { color: var(--danger); font-size: .9rem; min-height: 1.2em; margin-bottom: .5rem; }
.copyrow { display: flex; gap: .5rem; }
.copyrow .input { font-size: .85rem; }

/* Tabs */
.tabs { display: flex; gap: .25rem; border-bottom: 1px solid var(--line); margin-top: 1rem; }
.tab { background: none; border: 0; padding: .6rem .9rem; font: inherit; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
.tab.active { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }

/* Badges / banners */
.badge { display: inline-block; font-size: .75rem; font-weight: 700; padding: .15rem .55rem; border-radius: 999px; background: var(--line); color: var(--ink); vertical-align: middle; }
.badge.ok { background: var(--ok-soft); color: var(--ok); }
.badge.warn { background: var(--warn-soft); color: var(--warn); }
.badge.accent { background: var(--accent-soft); color: var(--accent); }
.badge.danger { background: var(--danger-soft); color: var(--danger); }
.banner { padding: .9rem 1.1rem; border-radius: var(--radius); margin-bottom: 1rem; border: 1px solid transparent; }
.banner.info { background: var(--accent-soft); border-color: #bfe3de; }
.banner.ok { background: var(--ok-soft); border-color: #bfe6c9; }
.banner.warn { background: var(--warn-soft); border-color: #f3d6ad; }
.banner.danger { background: var(--danger-soft); border-color: #f1c6c2; }
.banner strong { display: block; margin-bottom: .15rem; }

/* Stats */
.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin: 1rem 0; }
@media (max-width: 640px) { .stats { grid-template-columns: repeat(2, 1fr); } }
.stat { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: .8rem 1rem; }
.stat .label { font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
.stat .value { font-size: 1.35rem; font-weight: 700; }

/* People lists */
.people { list-style: none; padding: 0; margin: 0; }
.people li { display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .7rem 0; border-top: 1px solid var(--line); flex-wrap: wrap; }
.people li:first-child { border-top: 0; }
.people .who { display: flex; flex-direction: column; min-width: 0; }
.people .who small { color: var(--muted); word-break: break-all; }
.people .acts { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; }
.people li.me { background: var(--accent-soft); margin: 0 -1.25rem; padding-left: 1.25rem; padding-right: 1.25rem; }
.people li.me.pending { background: var(--warn-soft); }
.amount { font-weight: 700; font-variant-numeric: tabular-nums; }

/* Listing (guest view) */
.hero-item { font-size: 1.05rem; margin-bottom: .75rem; }
.meta { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 1rem 0 0; }
.meta div { font-size: .9rem; }
.meta b { display: block; font-size: 1.1rem; }
.split-big { font-size: 2rem; font-weight: 800; letter-spacing: -.02em; }
.pay-box { background: var(--bg); border: 1px dashed var(--line); border-radius: 12px; padding: 1rem; }
.pay-box .addr { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; word-break: break-all; font-size: 1rem; }
.notice { font-size: .85rem; color: var(--muted); background: var(--bg); padding: .6rem .8rem; border-radius: 10px; margin-bottom: 1rem; }
.progress { height: 8px; background: var(--line); border-radius: 999px; overflow: hidden; margin-top: .5rem; }
.progress > div { height: 100%; background: var(--accent); }

/* Landing */
.landing { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; align-items: center; min-height: calc(100vh - 70px); }
@media (max-width: 800px) { .landing { grid-template-columns: 1fr; gap: 1.5rem; } }
.landing h1 { font-size: 2.6rem; }
.landing .lead { font-size: 1.15rem; color: var(--muted); }
.steps { list-style: none; padding: 0; margin: 1.5rem 0 0; }
.steps li { padding-left: 2.2rem; position: relative; margin-bottom: .8rem; }
.steps li span { position: absolute; left: 0; top: 0; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; font-size: .85rem; display: grid; place-items: center; }

footer.foot { text-align: center; color: var(--muted); font-size: .85rem; padding: 2rem 1rem; }

#toast {
  position: fixed; left: 50%; bottom: 1.5rem; transform: translateX(-50%) translateY(20px);
  background: var(--ink); color: #fff; padding: .7rem 1.1rem; border-radius: 10px; opacity: 0;
  transition: .2s; pointer-events: none; z-index: 50; max-width: 90vw; font-size: .95rem;
}
#toast.show { opacity: 1; transform: translateX(-50%); }
#toast.error { background: var(--danger); }
